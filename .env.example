# Copy to .env (never commit .env). Values here are placeholders, not secrets.
STREAMFORGE_ENV=dev
AWS_REGION=ap-south-1
# Used by scripts/smoke_test.py against a deployed stack:
STREAMFORGE_API_URL=https://<api-id>.execute-api.<region>.amazonaws.com/dev/
STREAMFORGE_API_KEY=<fetch with the command in DEPLOYMENT.md>
